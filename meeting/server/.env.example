# Meeting Server Environment Template
PORT=5000
APP_BASE=/meet
SOCKET_PATH=/meet/socket.io
ALLOWED_ORIGINS=https://codeclass.vnotemate.com,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000
ROOMS_FILE=data/rooms.json

# CodeClass Bidirectional Bridge
CODECLASS_API=http://127.0.0.1:3001
# Must match MEETING_INTERNAL_SECRET (or JWT_SECRET) on CodeClass backend
MEETING_INTERNAL_SECRET=

# Mediasoup SFU Connection
SFU_SHARED_SECRET=
SFU_ADMIN_URL=
SFU_ADMIN_TOKEN=

# OpenAI-compatible AI provider (ưu tiên nếu được cấu hình)
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini

# Hoặc dùng Google Gemini trực tiếp
# GOOGLE_AI_API_KEY=
