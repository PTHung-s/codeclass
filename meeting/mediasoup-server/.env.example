# ===== mediasoup-server cấu hình =====
# Copy file này thành .env rồi điền giá trị thực tế

# Cổng HTTP (REST API + Socket.IO)
PORT=4443

# IP server bind. Giữ 0.0.0.0 trong Docker/cloud
LISTEN_IP=0.0.0.0

# !!! QUAN TRỌNG khi deploy lên server có IP public (VPS, EC2...):
# đặt IP PUBLIC của server vào đây để client kết nối được WebRTC.
# Nếu không đặt, chỉ chạy được trong máy local / cùng mạng LAN.
# Ví dụ: ANNOUNCED_IP=203.0.113.10
ANNOUNCED_IP=

# Dải port UDP/TCP cho media WebRTC.
# Nhớ mở dải port tương ứng trong firewall/security group!
RTC_MIN_PORT=40000
RTC_MAX_PORT=40100

# Số mediasoup worker (mỗi worker dùng 1 core CPU). Để trống = min(4, số core)
MEDIASOUP_WORKERS=
