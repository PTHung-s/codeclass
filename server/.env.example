# CodeClass Backend Environment Template
PORT=3001
NODE_ENV=development

# SQLite / Prisma database URL
DATABASE_URL="file:./dev.db"

# Authentication (use a strong random secret in production)
JWT_SECRET="replace-with-strong-random-secret"

# Comma-separated allowed frontend origins
CLIENT_URL="http://localhost:5173,http://127.0.0.1:5173"

# AI Providers (Primary + automatic fallback)
VILAO_API_KEY=""
VILAO_BASE_URL="https://api.vilao.ai/v1/chat/completions"
VILAO_MODEL=""
DEEPSEEK_API_KEY=""
DEEPSEEK_API_URL="https://api.deepseek.com/chat/completions"
DEEPSEEK_FALLBACK_MODEL="deepseek-chat"

# Integrated Meeting Service Bridge
MEETING_SERVER_URL="http://127.0.0.1:5000"
MEETING_PUBLIC_URL="/meet/"
# Must match MEETING_INTERNAL_SECRET in meeting/server/.env (falls back to JWT_SECRET if unset)
MEETING_INTERNAL_SECRET=""

# Optional Centrifugo Realtime
CENTRIFUGO_API_URL=""
CENTRIFUGO_API_KEY=""
CENTRIFUGO_TOKEN_SECRET=""
CENTRIFUGO_RPC_PROXY_SECRET=""

# Optional Cloudflare R2 Object Storage (Session videos / materials)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# Feature flags
AI_EXEC_ENABLED="true"
QUESTION_CALIBRATION_ENABLED="true"
