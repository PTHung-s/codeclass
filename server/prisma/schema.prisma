/// One row per (student × in-lesson code challenge), upserted on every Run.
/// `passed` is nullable on purpose: null means the challenge has no
/// expectedOutput to grade against (true for every C++/Python code_runner
/// block), so we still capture the code the student wrote and how many times
/// they ran it. false means graded-and-wrong, true means graded-and-correct.
model ChallengeAttempt {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  lessonId      String    @map("lesson_id")
  /// Mirrors PythonRunner's `saveKey`, e.g. "<lessonId>_stage_6".
  challengeKey  String    @map("challenge_key")
  title         String?
  language      String    @default("python")
  latestCode    String    @map("latest_code")
  firstPassCode String?   @map("first_pass_code")
  runCount      Int       @default(0) @map("run_count")
  failCount     Int       @default(0) @map("fail_count")
  passed        Boolean?
  firstPassAt   DateTime? @map("first_pass_at")
  lastRunAt     DateTime  @default(now()) @map("last_run_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeKey])
  @@index([lessonId])
  @@index([userId, lastRunAt])
  @@map("challenge_attempts")
}

/// A lesson recording a teacher explicitly starts and ends.
///
/// `sessionDate` (VN midnight) is the overwrite key: starting a new recording on
/// a day that already has one replaces it, while previous days survive. That
/// keeps storage bounded without destroying the ability to compare sessions.
model RecordingSession {
  id          String    @id @default(uuid())
  title       String?
  sessionDate DateTime  @map("session_date")
  startedAt   DateTime  @default(now()) @map("started_at")
  endedAt     DateTime? @map("ended_at")
  status      String    @default("recording") // recording | ended
  startedById String    @map("started_by")
  courseId    String?   @map("course_id")

  startedBy    User                   @relation("RecordingStarter", fields: [startedById], references: [id])
  participants RecordingParticipant[]

  @@index([sessionDate])
  @@index([status])
  @@map("recording_sessions")
}

/// One student inside a recording, with roll-up counters filled in on End.
model RecordingParticipant {
  id            String   @id @default(uuid())
  sessionId     String   @map("session_id")
  userId        String   @map("user_id")
  joinedAt      DateTime @default(now()) @map("joined_at")
  /// true when the teacher added this student mid-session rather than at Start.
  addedManually Boolean  @default(false) @map("added_manually")
  activeSeconds Int      @default(0) @map("active_seconds")
  tabOutCount   Int      @default(0) @map("tab_out_count")
  runCount      Int      @default(0) @map("run_count")
  finalCode     String?  @map("final_code")

  session RecordingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  events  RecordingEvent[]

  @@unique([sessionId, userId])
  @@index([userId])
  @@map("recording_participants")
}

/// A timestamped event — the data the draggable timeline is built from.
model RecordingEvent {
  id            String   @id @default(uuid())
  participantId String   @map("participant_id")
  at            DateTime
  /// code_snapshot | tab_out | tab_back | run | idle_start | paste | activity
  type          String
  code          String?
  label         String?
  passed        Boolean?
  /// Small JSON blob, e.g. {"lines":12,"chars":340,"lessonId":"..."}
  meta          String?

  participant RecordingParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId, at])
  @@map("recording_events")
}

