model QuizQuestionCalibration {
  id                  String   @id @default(uuid())
  questionId          String   @map("question_id")
  contentVersion      Int      @map("content_version")
  modelVersion        String   @default("smoothed-rate-v1") @map("model_version")
  sampleCount         Int      @default(0) @map("sample_count")
  uniqueStudentCount  Int      @default(0) @map("unique_student_count")
  correctCount        Int      @default(0) @map("correct_count")
