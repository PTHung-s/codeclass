  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, contentVersion, modelVersion])
  @@index([status])
  @@map("quiz_question_calibrations")
}

/// Global, course-agnostic quiz bank. Questions flow in (import/manual/AI), get
/// classified + QC'd by the LLM pipeline (quiz-classify-v2, self-consistency),
/// then wait in `ai_pending` for teacher approval before they can be distributed
/// to courses, adaptive tests, arena or exams.
model QuizBankItem {
  id          String  @id @default(uuid())
  // ── Content ──
  stem        String
  options     String  @default("[]") // JSON array of strings
  answerIndex Int     @default(0) @map("answer_index")
  explanation String  @default("")
  codeLanguage String @default("none") @map("code_language") // python | cpp | none
  language    String  @default("vi") // question text language
  // ── Provenance ──
  source      String  @default("manual") // manual | import | ai
  sourceFile  String? @map("source_file")
  sourceSkillId String? @map("source_skill_id") // skill the question carried where it came from (reference during review)
  fingerprint String? @unique
  // ── Lifecycle ──
  status      String  @default("draft") // draft | ai_pending | approved | rejected
  needsReview Boolean @default(false) @map("needs_review") // LLM self-consistency disagreed
  // ── Tags (LLM-assigned, human-approved) ──
  testsSkill      String? @map("tests_skill")
  testsSkillWeights String @default("{}") @map("tests_skill_weights") // JSON {skillId: weight 0..1, sum=1} — phân phối xác suất các skill có khả năng; argmax = testsSkill
  secondarySkillIds String @default("[]") @map("secondary_skill_ids") // JSON array
  requiresSkills  String  @default("[]") @map("requires_skills") // JSON array
  questionType    String? @map("question_type")
  cognitiveLevel  String? @map("cognitive_level")
  misconceptions  String  @default("{}") // JSON map: distractor index -> misconception id
  suitableFor     String  @default("[]") @map("suitable_for") // JSON array
  // ── Difficulty ──
  difficultyAuthored Int    @default(3) @map("difficulty_authored")
  difficultyBand     String @default("medium") @map("difficulty_band") // easy | medium | hard
  difficultyReason   String? @map("difficulty_reason")
  // ── QC ──
  qcStatus      String  @default("pending") @map("qc_status") // pending | pass | flag | reject
  qcIssues      String  @default("[]") @map("qc_issues") // JSON array
  qualityScores String  @default("{}") @map("quality_scores") // JSON {accuracy, clarity, engagement, style, presentation}
  qualityScore  Float?  @map("quality_score") // weighted composite
  qcNotes       String? @map("qc_notes")
  qcSuggestion  String? @map("qc_suggestion")
  // ── Pipeline metadata ──
  pipelineVersion String? @map("pipeline_version")
  aiModel         String? @map("ai_model")
  aiConfidence    Float?  @map("ai_confidence")
  aiReviewedAt    DateTime? @map("ai_reviewed_at")
  rounds          String  @default("[]") @map("rounds") // JSON: raw output của từng lượt LLM (self-consistency)
  // ── Approval ──
  reviewedBy  String?   @map("reviewed_by")
  reviewedAt  DateTime? @map("reviewed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([testsSkill])
  @@map("quiz_bank_items")
}

