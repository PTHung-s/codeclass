generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                                            String                @id @default(uuid())
  fullName                                      String                @map("full_name")
  nickname                                      String?               @map("nickname")
  email                                         String                @unique
  passwordHash                                  String                @map("password_hash")
  mustChangePassword                            Boolean               @default(false) @map("must_change_password")
  passwordResetAt                               DateTime?             @map("password_reset_at")
  passwordResetById                             String?               @map("password_reset_by_id")
  avatarUrl                                     String?               @map("avatar_url")
  role                                          String                @default("student")
  phone                                         String?
  bio                                           String?
  status                                        String                @default("active")
  createdAt                                     DateTime              @default(now()) @map("created_at")
  updatedAt                                     DateTime              @updatedAt @map("updated_at")
  lastLoginAt                                   DateTime?             @map("last_login_at")
  tokenBalance                                  Int                   @default(0) @map("token_balance")
  hintCredits                                   Int                   @default(0) @map("hint_credits")
  streakFreezes                                 Int                   @default(0) @map("streak_freezes")
  /// VN "YYYY-MM-DD" keys of days already bridged by a spent streak freeze.
  /// A gap bridged once must not cost another freeze on the next read.
  streakBridgedDays                             String                @default("[]") @map("streak_bridged_days")
  /// VN "YYYY-MM-DD" keys of missed days an admin/teacher manually rescued
  /// (ví dụ do lỗi hệ thống). Giống ngày bridged bởi khiên nhưng không tốn freeze.
  streakRescuedDays                             String                @default("[]") @map("streak_rescued_days")
  /// Total XP, maintained incrementally by xpLedger.ts (source: xp_transactions).
  xp                                            Int                   @default(0)
  // Avatar shop: which avatars are unlocked (JSON array of avatar ids) and the
  // currently selected avatar. `avatarUrl` is updated when selecting to keep
  // backward compatibility with the old avatar display logic.
  unlockedAvatars                              String                @default("[]") @map("unlocked_avatars")
  selectedAvatar                               String                @default("default") @map("selected_avatar")
  unlockedEmojis                               String                @default("[]") @map("unlocked_emojis")
  unlockedStickers                             String                @default("[]") @map("unlocked_stickers")
  gachaPity                                    Int                   @default(0) @map("gacha_pity")
  gemBalance                                   Int                   @default(0) @map("gem_balance")
  adaptiveTests                                 AdaptiveTestAttempt[]
  aiLogs                                        AILog[]
  announcements                                 Announcement[]
  assignedAssignments                           AssignmentStudent[]
  assignments                                   Assignment[]
  attendanceRecords                             AttendanceRecord[]
  dailyCheckIns                                 DailyCheckIn[]
  dailyCheckInsApproved                        DailyCheckIn[]        @relation("DailyCheckInApprover")
  takenAttendanceSessions                       AttendanceSession[]   @relation("AttendanceTakenBy")
  attendanceSessionsStarted                    AttendanceSession[]   @relation("AttendanceStartedBy")
  assignedBugs                                  BugReport[]           @relation("BugReportAssignee")
  bugReports                                    BugReport[]           @relation("BugReportReporter")
  challengeAttempts                             ChallengeAttempt[]
  chapterProgress                               ChapterProgress[]
  classGroupMemberships                         ClassGroupMember[]
  ownedClasses                                  ClassGroup[]          @relation("ClassOwner")
  globalTuitionPayments                        GlobalTuitionPayment[]
  contestAIFeedbacks                            ContestAIFeedback[]   @relation("ContestFeedbackStudent")
  contestParticipants                           ContestParticipant[]
  contestSubmissions                            ContestSubmission[]
  createdContests                               Contest[]             @relation("ContestCreator")
  courseMembers                                 CourseMember[]
  ownedCourses                                  Course[]              @relation("CourseOwner")
  arenaAnswers                                  DebugArenaAnswer[]
  arenaKicks                                    DebugArenaKick[]      @relation("ArenaKicks")
  arenaMatchesCreated                           DebugArenaMatch[]     @relation("ArenaCreator")
  arenaPlayers                                  DebugArenaPlayer[]
  game_matches                                  game_matches[]
  game_players                                  game_players[]
  reviewedHackTests                             HackTest[]            @relation("HackTestReviewer")
  hackTests                                     HackTest[]            @relation("HackTestProposer")
  helpReplies                                   HelpReply[]           @relation("HelpReplyAuthor")
  claimedHelps                                  HelpRequest[]         @relation("HelpRequestClaimer")
  helpRequests                                  HelpRequest[]         @relation("HelpRequestAuthor")
  hintReveals                                   HintReveal[]
  lessonProgress                                LessonProgress[]
  materialCollections                           MaterialCollection[]
  materials                                     Material[]
  notifications                                 Notification[]
  problemSubmissions                            ProblemSubmission[]
  problems                                      Problem[]
  questProgress                                 QuestProgress[]
  recordingsStarted                             RecordingSession[]    @relation("RecordingStarter")
  recordingParticipations                       RecordingParticipant[]
  honourShowings                                HonourShowing[]       @relation("HonourViewer")
  honourPraisesGiven                            HonourPraise[]        @relation("PraiseAuthor")
  honourPraisesReceived                         HonourPraise[]        @relation("PraiseHonouree")
  quizAttempts                                  QuizAttempt[]
  quizQuestionResponses                         QuizQuestionResponse[]
  rankSnapshots                                 RankSnapshot[]
  recommendations                               Recommendation[]
  studentSkillMasteries                         StudentSkillMastery[]
  skillEvidences                                SkillEvidence[]
  dailyStudyItems                               DailyStudyItem[]
  dailyStudyPlans                               DailyStudyPlan[]
  studentWeaknessTags                           StudentWeaknessTag[]
  studentRosterExclusions                      StudentRosterExclusion[]   @relation("RosterExclusionStudent")
  studentRosterExclusionsRemoved              StudentRosterExclusion[]   @relation("RosterExclusionRemover")
  checklistAssignmentsCreated                  ChecklistAssignment[]   @relation("ChecklistCreator")
  checklistAssignmentStudents                   ChecklistAssignmentStudent[]
  checklistItemCompletions                      ChecklistItemCompletion[]
  codeDuelMatchesCreated                        CodeDuelMatch[]         @relation("CodeDuelCreator")
  codeDuelVerified                             CodeDuelSubmission[]    @relation("CodeDuelVerifier")
  codeDuelPlayers                               CodeDuelPlayer[]
  codeDuelSubmissions                           CodeDuelSubmission[]
  reviewsWritten                                Review[]              @relation("Reviewer")
  rewardRedemptions                             RewardRedemption[]
  sessionLogs                                   SessionLog[]
  shield_cores_shield_cores_destroyed_byTousers shield_cores[]        @relation("shield_cores_destroyed_byTousers")
  shield_cores_shield_cores_creator_idTousers   shield_cores[]        @relation("shield_cores_creator_idTousers")
  submissions                                   Submission[]
  teacherNotes                                  TeacherNote[]         @relation("TeacherNotes")
  studentNotes                                  TeacherNote[]         @relation("StudentNotes")
  tokenTransactions                             TokenTransaction[]
  xpTransactions                                XpTransaction[]
  tuitionPayments                               TuitionPayment[]
  userBadges                                    UserBadge[]
  sessionLessonsCreated                         SessionLesson[]        @relation("SessionLessonCreator")
  sessionCodeFilesCreated                       SessionCodeFile[]      @relation("SessionCodeFileCreator")
  sessionMaterialsCreated                       SessionMaterial[]      @relation("SessionMaterialCreator")
  sessionQuizProgress                           UserSessionProgress[]
  sessionQuizAttempts                           SessionQuizAttempt[]
  gachaPulls                                    GachaPull[]
  puzzlePieces                                  UserPuzzlePiece[]
  puzzleClaims                                  PhysicalRewardClaim[]
  examsCreated                                  Exam[]                 @relation("ExamCreator")
  examAttempts                                  ExamAttempt[]
  examViolations                                ExamViolation[]
  examLiveSnapshots                             ExamLiveSnapshot[]
  examGradeJobsStarted                          ExamGradeJob[]         @relation("ExamGradeStarter")
  codeLabSnippets                               CodeLabSnippet[]
  hostedMeetingRooms                            MeetingRoom[]          @relation("MeetingHost")
  meetingAttendances                            MeetingAttendance[]
  meetingQuizSubmissions                        MeetingQuizSubmission[]

  @@map("users")
}

model Course {
  id              String                @id @default(uuid())
  title           String
  description     String?
  coverImageUrl   String?               @map("cover_image_url")
  ownerId         String                @map("owner_id")
  status          String                @default("draft")
  visibility      String                @default("private")
  kind            String                @default("content") // content=normal | session=buổi-dạy-xong-mới-thêm
  startDate       DateTime?             @map("start_date")
  endDate         DateTime?             @map("end_date")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  adaptiveTests   AdaptiveTestAttempt[]
  announcements   Announcement[]
  assignments     Assignment[]
  bugReports      BugReport[]
  contests        Contest[]
  courseMaterials CourseMaterial[]
  members         CourseMember[]
  owner           User                  @relation("CourseOwner", fields: [ownerId], references: [id])
  arenaMatches    DebugArenaMatch[]     @relation("ArenaCourse")
  codeDuelMatches CodeDuelMatch[]
  game_matches    game_matches[]
  lessons         Lesson[]
  modules         Module[]
  teacherNotes    TeacherNote[]
  sessionLessons  SessionLesson[]
  exams           Exam[]
  meetingRooms    MeetingRoom[]

  @@map("courses")
}

model CourseMember {
  id               String   @id @default(uuid())
  courseId         String   @map("course_id")
  userId           String   @map("user_id")
  roleInCourse     String   @default("student") @map("role_in_course")
  scheduleWeekdays String?  @map("schedule_weekdays")
  joinedAt         DateTime @default(now()) @map("joined_at")
  status           String   @default("active")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@map("course_members")
}

model Module {
  id                String                @id @default(uuid())
  courseId          String                @map("course_id")
  title             String
  description       String?
  orderIndex        Int                   @default(0) @map("order_index")
  status            String                @default("draft")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  adaptiveTests     AdaptiveTestAttempt[]
  assignments       Assignment[]
  chapterProgress   ChapterProgress[]
  debugArenaMatches DebugArenaMatch[]     @relation("ArenaModule")
  lessons           Lesson[]
  course            Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("modules")
}

model Lesson {
  id                String           @id @default(uuid())
  courseId          String           @map("course_id")
  moduleId          String           @map("module_id")
  title             String
  description       String?
  content           String?
  orderIndex        Int              @default(0) @map("order_index")
  status            String           @default("draft")
  estimatedDuration Int?             @map("estimated_duration")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  assignments       Assignment[]
  assignmentItems   AssignmentItem[]
  challengeAttempts ChallengeAttempt[]
  lessonMaterials   LessonMaterial[]
  progress          LessonProgress[]
  module            Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  course            Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quizzes           Quiz[]

  @@map("lessons")
}

model Material {
  id              String           @id @default(uuid())
  title           String
  description     String?
  type            String
  fileUrl         String?          @map("file_url")
  linkUrl         String?          @map("link_url")
  visibility      String           @default("student-visible")
  createdById     String           @map("created_by")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  courseMaterials CourseMaterial[]
  lessonMaterials LessonMaterial[]
  collectionItems MaterialItem[]
  createdBy       User             @relation(fields: [createdById], references: [id])

  @@map("materials")
}

model MaterialCollection {
  id          String         @id @default(uuid())
  title       String
  slug        String         @unique
  description String?
  type        String         @default("collection")
  coverUrl    String?        @map("cover_url")
  visibility  String         @default("student-visible")
  createdById String         @map("created_by")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  createdBy   User           @relation(fields: [createdById], references: [id])
  items       MaterialItem[]

  @@map("material_collections")
}

model MaterialItem {
  id           String             @id @default(uuid())
  collectionId String             @map("collection_id")
  materialId   String?            @map("material_id")
  problemId    String?            @map("problem_id")
  title        String
  description  String?
  type         String
  sourceUrl    String?            @map("source_url")
  orderIndex   Int                @default(0) @map("order_index")
  metadata     String?
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  problem      Problem?           @relation(fields: [problemId], references: [id])
  material     Material?          @relation(fields: [materialId], references: [id])
  collection   MaterialCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@map("material_items")
}

model LessonMaterial {
  id         String   @id @default(uuid())
  lessonId   String   @map("lesson_id")
  materialId String   @map("material_id")
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, materialId])
  @@map("lesson_materials")
}

model CourseMaterial {
  id         String   @id @default(uuid())
  courseId   String   @map("course_id")
  materialId String   @map("material_id")
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, materialId])
  @@map("course_materials")
}

model Contest {
  id              String               @id @default(uuid())
  courseId        String?              @map("course_id")
  title           String
  description     String?
  durationMinutes Int                  @default(120) @map("duration_minutes")
  startDeadline   DateTime?            @map("start_deadline")
  visibility      String               @default("course")
  status          String               @default("draft")
  showLeaderboard String               @default("after_finish") @map("show_leaderboard")
  allowReview     Boolean              @default(true) @map("allow_review")
  maxSubmissions  Int?                 @map("max_submissions")
  instructions    String?
  createdById     String               @map("created_by")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  aiFeedbacks     ContestAIFeedback[]
  participants    ContestParticipant[]
  problems        ContestProblem[]
  submissions     ContestSubmission[]
  createdBy       User                 @relation("ContestCreator", fields: [createdById], references: [id])
  course          Course?              @relation(fields: [courseId], references: [id])

  @@map("contests")
}

model ContestAIFeedback {
  id              String   @id @default(uuid())
  contestId       String   @map("contest_id")
  studentId       String   @map("student_id")
  status          String   @default("pending")
  provider        String   @default("deepseek")
  model           String   @default("deepseek-chat")
  summary         String?
  problemFeedback String   @default("[]") @map("problem_feedback")
  rawResponse     String?  @map("raw_response")
  error           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  student         User     @relation("ContestFeedbackStudent", fields: [studentId], references: [id], onDelete: Cascade)
  contest         Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@unique([contestId, studentId])
  @@map("contest_ai_feedbacks")
}

model ContestProblem {
  id          String              @id @default(uuid())
  contestId   String              @map("contest_id")
  problemId   String              @map("problem_id")
  orderIndex  Int                 @default(0) @map("order_index")
  points      Int                 @default(100)
  problem     Problem             @relation(fields: [problemId], references: [id], onDelete: Cascade)
  contest     Contest             @relation(fields: [contestId], references: [id], onDelete: Cascade)
  submissions ContestSubmission[]

  @@unique([contestId, problemId])
  @@map("contest_problems")
}

model ContestParticipant {
  id         String    @id @default(uuid())
  contestId  String    @map("contest_id")
  studentId  String    @map("student_id")
  startedAt  DateTime? @map("started_at")
  expiresAt  DateTime? @map("expires_at")
  finishedAt DateTime? @map("finished_at")
  status     String    @default("registered")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  student    User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  contest    Contest   @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@unique([contestId, studentId])
  @@map("contest_participants")
}

model ContestSubmission {
  id               String         @id @default(uuid())
  contestId        String         @map("contest_id")
  contestProblemId String         @map("contest_problem_id")
  problemId        String         @map("problem_id")
  studentId        String         @map("student_id")
  code             String
  language         String         @default("python")
  verdict          String?
  score            Float          @default(0)
  maxScore         Float          @default(100) @map("max_score")
  passedTests      Int            @default(0) @map("passed_tests")
  totalTests       Int            @default(0) @map("total_tests")
  feedback         String?
  submittedAt      DateTime       @default(now()) @map("submitted_at")
  student          User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  problem          Problem        @relation(fields: [problemId], references: [id], onDelete: Cascade)
  contestProblem   ContestProblem @relation(fields: [contestProblemId], references: [id], onDelete: Cascade)
  contest          Contest        @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@map("contest_submissions")
}

model Problem {
  id                 String              @id @default(uuid())
  title              String
  shortDescription   String?             @map("short_description")
  statement          String?
  difficulty         String              @default("easy")
  estimatedTime      Int?                @map("estimated_time")
  starterCode        String?             @map("starter_code")
  sampleInput        String?             @map("sample_input")
  sampleOutput       String?             @map("sample_output")
  requirementsText   String?             @map("requirements_text")
  rubric             String?
  testCases          String?             @map("test_cases")
  hints              String?
  teacherSolution    String?             @map("teacher_solution")
  status             String              @default("draft")
  createdById        String              @map("created_by")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  // ── Skill tagging (AI-enriched, teacher-approved) ──
  skillId            String?             @map("skill_id") // final approved skill
  aiSkillSuggest     String?             @map("ai_skill_suggest") // AI suggested skill
  skillTagStatus     String              @default("untagged") @map("skill_tag_status") // untagged | ai_pending | approved | rejected
  assignments        Assignment[]
  assignmentItems    AssignmentItem[]
  contestProblems    ContestProblem[]
  contestSubmissions ContestSubmission[]
  hackTests          HackTest[]
  helpRequests       HelpRequest[]
  hintReveals        HintReveal[]
  progressiveHints   Hint[]
  materialItems      MaterialItem[]
  problemSubmissions ProblemSubmission[]
  tags               ProblemTag[]
  createdBy          User                @relation(fields: [createdById], references: [id])

  @@map("problems")
}

model HackTest {
  id             String    @id @default(uuid())
  problemId      String    @map("problem_id")
  proposerId     String    @map("proposer_id")
  input          String
  expectedOutput String    @map("expected_output")
  note           String?
  status         String    @default("pending")
  validationNote String?   @map("validation_note")
  impactedCount  Int       @default(0) @map("impacted_count")
  reviewedById   String?   @map("reviewed_by")
  reviewedAt     DateTime? @map("reviewed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  reviewedBy     User?     @relation("HackTestReviewer", fields: [reviewedById], references: [id])
  proposer       User      @relation("HackTestProposer", fields: [proposerId], references: [id], onDelete: Cascade)
  problem        Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@map("hack_tests")
}

model ProblemTag {
  id        String  @id @default(uuid())
  problemId String  @map("problem_id")
  tag       String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@map("problem_tags")
}

model Assignment {
  id                  String              @id @default(uuid())
  courseId            String?             @map("course_id")
  moduleId            String?             @map("module_id")
  lessonId            String?             @map("lesson_id")
  problemId           String?             @map("problem_id")
  groupName           String?             @map("group_name")
  title               String
  description         String?
  instructions        String?
  submissionType      String              @default("code-text") @map("submission_type")
  deadline            DateTime?
  publishDate         DateTime?           @map("publish_date")
  maxScore            Float               @default(10) @map("max_score")
  allowLateSubmission   Boolean             @default(false) @map("allow_late_submission")
  latePenaltyRule       String?             @map("late_penalty_rule")
  strictDeadline        Boolean             @default(false) @map("strict_deadline")
  autoAssignNewStudents Boolean             @default(false) @map("auto_assign_new_students")
  rewardOnTime          Boolean             @default(true) @map("reward_on_time")
  bonusTokens           Int                 @default(0) @map("bonus_tokens")
  bonusXp               Int                 @default(0) @map("bonus_xp")
  reminderSentAt        DateTime?           @map("reminder_sent_at")
  isRequired            Boolean             @default(true) @map("is_required")
  status                String              @default("draft")
  createdById           String              @map("created_by")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  assignedStudents      AssignmentStudent[]
  items                 AssignmentItem[]
  createdBy             User                @relation(fields: [createdById], references: [id])
  problem               Problem?            @relation(fields: [problemId], references: [id])
  lesson                Lesson?             @relation(fields: [lessonId], references: [id])
  module                Module?             @relation(fields: [moduleId], references: [id])
  course                Course?             @relation(fields: [courseId], references: [id])
  rubricCriteria        RubricCriterion[]
  submissions           Submission[]

  @@map("assignments")
}

model AssignmentItem {
  id           String     @id @default(uuid())
  assignmentId String     @map("assignment_id")
  itemType     String     @map("item_type") // "problem" | "quiz" | "lesson"
  problemId    String?    @map("problem_id")
  quizId       String?    @map("quiz_id")
  lessonId     String?    @map("lesson_id")
  orderIndex   Int        @default(0) @map("order_index")
  createdAt    DateTime   @default(now()) @map("created_at")

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  problem    Problem?   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  quiz       Quiz?      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  lesson     Lesson?    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([assignmentId, orderIndex])
  @@index([problemId])
  @@index([quizId])
  @@index([lessonId])
  @@map("assignment_items")
}

model RubricCriterion {
  id           String     @id @default(uuid())
  assignmentId String     @map("assignment_id")
  name         String
  maxScore     Float      @default(5) @map("max_score")
  description  String?
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@map("rubric_criteria")
}

model SubmissionVersion {
  id           String     @id @default(uuid())
  submissionId String     @map("submission_id")
  contentText  String?    @map("content_text")
  fileUrl      String?    @map("file_url")
  linkUrl      String?    @map("link_url")
  note         String?
  version      Int        @default(1)
  createdAt    DateTime   @default(now()) @map("created_at")
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("submission_versions")
}

model Hint {
  id         String       @id @default(uuid())
  problemId  String       @map("problem_id")
  orderIndex Int          @default(0) @map("order_index")
  content    String
  reveals    HintReveal[]
  problem    Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@map("hints")
}

model HintReveal {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  problemId String   @map("problem_id")
  hintId    String   @map("hint_id")
  createdAt DateTime @default(now()) @map("created_at")
  hint      Hint     @relation(fields: [hintId], references: [id], onDelete: Cascade)
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, hintId])
